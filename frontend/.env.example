# =====================================================================
# CONSIST — Environment Configuration
# =====================================================================
# Copy this file to `.env` or `.env.local` and configure your credentials.
# NEVER commit your `.env` or service role key to version control.
# =====================================================================

# --- SUPABASE PUBLIC CONFIGURATION (Required for client & browser) ---
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# --- SUPABASE SERVER-SIDE CONFIGURATION (Required for Nitro server SSR & admin functions) ---
# Used exclusively inside server functions (e.g., permanent account deletion)
# Never prefixed with VITE_ to prevent bundling into client-side code.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# --- OPTIONAL: LOVABLE CLOUD BRIDGE (Only when deployed inside Lovable environment) ---
# VITE_LOVABLE_SUPABASE_URL=""
# VITE_LOVABLE_SUPABASE_ANON_KEY=""

