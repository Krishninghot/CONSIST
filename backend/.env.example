# =====================================================================
# CONSIST — Backend Environment Configuration
# =====================================================================
# Copy this file to `.env` or set these variables in your deployment / CI environment.
# NEVER commit your production service role key or db password to version control.
# =====================================================================

# Supabase Project Credentials
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# PostgreSQL Direct Connection (Used by CLI, Drizzle, or Prisma)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Optional: Supabase CLI Project ID
SUPABASE_PROJECT_ID="your-project-ref"
